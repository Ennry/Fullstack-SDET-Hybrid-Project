# Production environment (for smoke tests only)
NODE_ENV=production

# API Configuration
API_BASE_URL=https://conduit-api.bondaracademy.com/api
UI_BASE_URL=https://conduit.bondaracademy.com

# Test User Credentials (use dedicated prod test account with limited permissions)
